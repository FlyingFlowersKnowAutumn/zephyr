# 复制为 .env 后填写真实值（.env 已在 .gitignore 中，不会被提交）
POSTGRES_USER=
POSTGRES_PASSWORD=

# 建议用 openssl rand -base64 48 生成
JWT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=

# 站点对外地址，例如 https://your-domain.com
BLOG_BASE_URL=

# 允许的跨域来源，逗号分隔，例如 https://www.your-domain.com,https://your-domain.com
# 只有「前端域名 ≠ API 域名」时才需要填：当前 nginx 把 /api 同源反代到网关，
# 浏览器不会触发跨域检查，留空即可。
# 【将来拆域名必看】若改成 www.your-domain.com 放前端、api.your-domain.com 放接口，
# 这里必须填前端域名（https://www.your-domain.com），否则前端所有请求都会被 CORS 拦截。
CORS_ALLOWED_ORIGINS=
# 站点所有者邮箱：用这个邮箱注册的账号自动获得 blogger 角色；留空则一律普通用户
BLOG_OWNER_EMAIL=
